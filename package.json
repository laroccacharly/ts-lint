{
  "name": "ts-lint",
  "version": "0.8.0",
  "description": "oxlint JS plugin with rules for Effect TypeScript code",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./plugin.js",
    "./config": {
      "types": "./config.d.ts",
      "default": "./config.js"
    }
  },
  "scripts": {
    "build": "bun build plugin.ts --outfile plugin.js --target node --format esm",
    "lint": "effect-tsgo --tsrs-lint oxlint --type-aware --type-check"
  },
  "peerDependencies": {
    "@effect/tsgo": ">=0.67.1",
    "oxlint": ">=1.88.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.1",
    "oxlint": "1.91.0"
  },
  "files": [
    "config.d.ts",
    "config.js",
    "plugin.js",
    "plugin.ts"
  ]
}
